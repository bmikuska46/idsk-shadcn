        "@fontsource/source-sans-pro"
      ],
      "files": [
        {
          "path": "src/index.css",
          "type": "registry:file",
          "target": "src/styles/idsk.css"
        }
      ],
      "docs": "Import `src/styles/idsk.css` in your root layout or app entry (after Tailwind). Load Source Sans Pro, e.g. `import '@fontsource/source-sans-pro/400.css'`, `700.css` and `900.css` (Headline L uses weight 900)."
