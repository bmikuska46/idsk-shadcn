{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "idsk-shadcn",
  "homepage": "https://github.com/bmikuska46/idsk-shadcn",
  "items": [
    {
      "name": "utils",
      "type": "registry:lib",
      "title": "Utils",
      "description": "cn() helper built with clsx and tailwind-merge.",
      "dependencies": ["clsx", "tailwind-merge"],
      "files": [
        {
          "path": "src/lib/utils.ts",
          "type": "registry:lib"
        }
      ]
    },
    {
      "name": "styles",
      "type": "registry:item",
      "title": "IDSK Styles",
      "description": "IDSK design tokens, focus ring, typography and layout utility classes.",
      "dependencies": ["@fontsource/source-sans-pro"],
      "files": [
        {
          "path": "src/index.css",
          "type": "registry:file",
          "target": "src/styles/idsk.css"
        }
      ],
      "docs": "Import `src/styles/idsk.css` in your root layout or app entry (after Tailwind). Load Source Sans Pro, e.g. `import '@fontsource/source-sans-pro/400.css'` and `700.css`."
    },
    {
